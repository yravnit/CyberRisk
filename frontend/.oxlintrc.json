# oxlint configuration for the CyberRisk frontend.
# Run with:  npm run lint
# Docs: https://oxc.rs/docs/guide/usage/linter.html
{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["react", "unicorn", "import", "jsx-a11y"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "pedantic": "off"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    ".oxlintrc.json"
  ],
  "rules": {
    "no-unused-vars": ["warn", {
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_"
    }],
    "no-undef": "error",
    "no-dupe-keys": "error",
    "no-unreachable": "error",
    "no-self-assign": "error",
    "eqeqeq": ["error", "smart"],
    "no-console": "off",

    "react/purity": "warn",
    "react/set-state-in-effect": "warn",
    "react/no-array-index-key": "warn",
    "react/exhaustive-effect-dependencies": "warn",

    "unicorn/no-array-sort": "warn",
    "unicorn/consistent-function-scoping": "warn",
    "react/no-object-type-as-default-prop": "warn"
  },
  "overrides": [
    {
      "files": ["src/components/ui/**/*.{js,jsx}", "src/hooks/**/*.js"],
      "rules": {
        "no-unused-vars": "off"
      }
    }
  ]
}